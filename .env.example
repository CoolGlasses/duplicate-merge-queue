# Server
PORT=8080

# HubSpot OAuth app (created later in a HubSpot developer account — gate, not done)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8080/oauth/callback

# Token encryption at rest: 32-byte key as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If absent, tokens are stored PLAINTEXT with a loud startup warning (dev only).
TOKEN_ENC_KEY=

# Stripe (vendor-side billing; account already exists — keys arrive via env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PORTAL=

# Operator UI auth
SESSION_SECRET=
# Generate with: npm run hash-password -- 'your-password'
OPERATOR_PASSWORD_HASH=
